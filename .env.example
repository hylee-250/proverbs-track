# 팀원 명단 (쉼표로 구분). 이 이름들이 로그인 화면에 나타나요.
MEMBERS=홍길동,김철수,이영희

# Neon 연결 문자열. 비워 두면 로컬 SQLite(local.db)를 사용해요.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 필사 기간 (서울 시간 기준, YYYY-MM-DD)
START_DATE=2026-10-01
END_DATE=2026-11-30

# 화면 상단 제목
APP_TITLE=잠언 필사 챌린지
